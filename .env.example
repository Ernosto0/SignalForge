# Copy to .env and fill in. .env is git-ignored.

DATABASE_URL=postgresql+psycopg://signalforge:signalforge@localhost:5433/signalforge

# LLM (OpenAI). All tiers use the cheap model during development (plan §10).
# For quality-evaluation runs, raise analysis/synthesis to gpt-6.1-sol (20x pricier)
# or synthesis to gpt-6-astra (100x pricier).
OPENAI_API_KEY=
LLM_MODEL_FAST=gpt-6-luna
LLM_MODEL_ANALYSIS=gpt-6-luna
LLM_MODEL_SYNTHESIS=gpt-6-luna
# Reserved for post-V0 evaluation (plan §10); unused for now.
JEV_API_KEY=

# Search provider: serper (https://serper.dev, default) or serpapi (https://serpapi.com).
# Only the selected provider's key is needed.
SEARCH_PROVIDER=serper
SERPER_API_KEY=
SERP_API_KEY=

# Salt for hashing source authors (independence counting). Required from the extract stage on;
# any long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Changing it changes every author hash, so keep it stable for a database.
AUTHOR_HASH_SALT=

DEFAULT_MARKET_PACK=tr
DEFAULT_BUDGET_USD=10
# live | record | replay
CACHE_MODE=live

# Frontend -> backend (used by Next.js server-side rewrites)
BACKEND_URL=http://127.0.0.1:8000
