# Copy to .env and fill in. .env is git-ignored.

DATABASE_URL=postgresql+psycopg://signalforge:signalforge@localhost:5433/signalforge

# LLM (OpenAI). Model tiers can be overridden per deployment;
# set LLM_MODEL_SYNTHESIS=gpt-6-astra for stronger (5x pricier) final reports.
OPENAI_API_KEY=
LLM_MODEL_FAST=gpt-6-luna
LLM_MODEL_ANALYSIS=gpt-6.1-sol
LLM_MODEL_SYNTHESIS=gpt-6.1-sol
# Reserved for post-V0 evaluation (plan §10); unused for now.
JEV_API_KEY=

# Search provider: serpapi (https://serpapi.com)
SEARCH_PROVIDER=serpapi
SERP_API_KEY=

DEFAULT_MARKET_PACK=tr
DEFAULT_BUDGET_USD=10
# live | record | replay
CACHE_MODE=live

# Frontend -> backend (used by Next.js server-side rewrites)
BACKEND_URL=http://127.0.0.1:8000
